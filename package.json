{
  "name": "pizza-max-restaurant-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/audit-accessibility.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md",
    "assets:demo": "node scripts/download-demo-assets.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
